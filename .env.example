# PostgreSQL
POSTGRES_DB=log_utils
POSTGRES_USER=log_utils
POSTGRES_PASSWORD=<generate>

# RabbitMQ
RABBITMQ_DEFAULT_USER=log_utils
RABBITMQ_DEFAULT_PASS=<generate>

# MinIO
MINIO_ROOT_USER=log_utils
MINIO_ROOT_PASSWORD=<generate>
MINIO_BUCKET=raw-logs

# OpenRouter (LLM template generation)
OPENROUTER_API_KEY=<your-openrouter-key>
OPENROUTER_MODEL=openrouter/auto
